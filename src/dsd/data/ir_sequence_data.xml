<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_dsd_driver" model="ir.sequence">
        <field name="name">DSD Driver</field>
        <field name="code">dsd.driver</field>
        <field name="prefix">DRV-</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dsd_visit_plan" model="ir.sequence">
        <field name="name">DSD Visit Plan</field>
        <field name="code">dsd.visit.plan</field>
        <field name="prefix">VP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dsd_visit_list" model="ir.sequence">
        <field name="name">DSD Visit List</field>
        <field name="code">dsd.visit.list</field>
        <field name="prefix">VL/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dsd_loading_confirmation" model="ir.sequence">
        <field name="name">DSD Loading Confirmation</field>
        <field name="code">dsd.loading.confirmation</field>
        <field name="prefix">LC/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_dsd_check_record" model="ir.sequence">
        <field name="name">DSD Check-Out / Check-In</field>
        <field name="code">dsd.check.record</field>
        <field name="prefix">CO-CI/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
