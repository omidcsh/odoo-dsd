<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsd_route_form" model="ir.ui.view">
        <field name="name">dsd.route.form</field>
        <field name="model">dsd.route</field>
        <field name="arch" type="xml">
            <form string="DSD Route">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_customers" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="partner_count" widget="statinfo" string="Customers"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. North City Monday Run"/></h1>
                        <div class="text-muted"><field name="code"/></div>
                    </div>
                    <group>
                        <group name="main" string="Route">
                            <field name="active" invisible="1"/>
                            <field name="warehouse_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="color" invisible="1"/>
                        </group>
                        <group name="days" string="Serving Days">
                            <div class="o_row">
                                <field name="mon"/><field name="tue"/><field name="wed"/>
                                <field name="thu"/><field name="fri"/><field name="sat"/><field name="sun"/>
                            </div>
                        </group>
                    </group>
                    <notebook>
                        <page string="Capacity Limits" name="capacity">
                            <group>
                                <group string="Activation (checked in this order)">
                                    <field name="cap_weight"/>
                                    <field name="cap_volume"/>
                                    <field name="cap_stops"/>
                                    <div invisible="not cap_stops"><field name="max_stops"/></div>
                                    <field name="cap_loading_units"/>
                                    <div invisible="not cap_loading_units"><field name="lu_uom_id"/></div>
                                    <field name="max_load_attempts"/>
                                    <field name="single_daily_tour"/>
                                </group>
                                <group string="Duration">
                                    <field name="cap_duration"/>
                                    <div invisible="not cap_duration"><field name="max_duration_hours"/></div>
                                </group>
                            </group>
                        </page>
                        <page string="Default Resources" name="defaults">
                            <group>
                                <group>
                                    <field name="default_driver_id"/>
                                    <field name="default_vehicle_id"/>
                                    <field name="default_trailer_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dsd_route_list" model="ir.ui.view">
        <field name="name">dsd.route.list</field>
        <field name="model">dsd.route</field>
        <field name="arch" type="xml">
            <list string="DSD Routes">
                <field name="name"/>
                <field name="code"/>
                <field name="warehouse_id"/>
                <field name="default_driver_id" optional="hide"/>
                <field name="default_vehicle_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_dsd_route_search" model="ir.ui.view">
        <field name="name">dsd.route.search</field>
        <field name="model">dsd.route</field>
        <field name="arch" type="xml">
            <search string="DSD Routes">
                <field name="name"/>
                <field name="code"/>
                <field name="warehouse_id"/>
                <field name="default_driver_id"/>
                <filter name="cap_stops" string="Stop Limit" domain="[('cap_stops', '=', True)]"/>
                <filter name="cap_duration" string="Duration Limit" domain="[('cap_duration', '=', True)]"/>
                <group>
                    <filter name="group_warehouse" string="Warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dsd_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">dsd.route</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first DSD route</p>
            <p>A route defines the serving days, capacity limits and default driver/vehicle for tours.</p>
        </field>
    </record>
</odoo>
