<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsd_visit_list_generate_form" model="ir.ui.view">
        <field name="name">dsd.visit.list.generate.form</field>
        <field name="model">dsd.visit.list.generate</field>
        <field name="arch" type="xml">
            <form string="Generate Visit Lists">
                <field name="state" invisible="1"/>
                <group invisible="state == 'done'">
                    <group string="Visit Plans">
                        <field name="plan_ids" widget="many2many_tags"
                               nolabel="1" colspan="2"/>
                    </group>
                    <group string="Period">
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="dry_run"/>
                    </group>
                </group>
                <group invisible="state != 'done'">
                    <field name="result_html" nolabel="1" readonly="1" colspan="2"/>
                </group>
                <footer>
                    <button name="action_generate" type="object" string="Generate"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_view_created" type="object" string="Open Generated Lists"
                            invisible="state != 'done' or dry_run"/>
                    <button string="Close" special="cancel"
                            class="btn-secondary" invisible="state == 'form'"/>
                    <button string="Cancel" special="cancel" invisible="state == 'done'"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_dsd_visit_list_generate" model="ir.actions.act_window">
        <field name="name">Generate Visit Lists</field>
        <field name="res_model">dsd.visit.list.generate</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
