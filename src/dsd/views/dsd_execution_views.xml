<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== Loading Confirmation ===================== -->
    <record id="view_dsd_lc_form" model="ir.ui.view">
        <field name="name">dsd.loading.confirmation.form</field>
        <field name="model">dsd.loading.confirmation</field>
        <field name="arch" type="xml">
            <form string="Loading Confirmation">
                <header>
                    <button name="action_complete" type="object" string="Complete &amp; Seal"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_reprepare" type="object" string="Re-Prepare Targets"
                            invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,done"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tour_id" readonly="state == 'done'"/>
                            <field name="counting_scope" readonly="state == 'done'"/>
                        </group>
                        <group>
                            <field name="difference_count"/>
                            <field name="has_difference" invisible="1"/>
                            <field name="completed_by_id"/>
                        </group>
                    </group>
                    <field name="line_ids" readonly="state == 'done'">
                        <list editable="bottom" decoration-danger="difference_qty != 0">
                            <field name="counting_group_id" invisible="not counting_group_id"/>
                            <field name="product_id" invisible="not product_id"/>
                            <field name="uom_id"/>
                            <field name="target_qty"/>
                            <field name="counted_qty"/>
                            <field name="difference_qty" optional="show"/>
                            <field name="reason_id" invisible="difference_qty == 0"
                                   required="difference_qty != 0"/>
                        </list>
                    </field>
                    <button name="action_itemize" type="object" string="Itemize Group Differences"
                            icon="fa-list" invisible="state == 'done'"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_dsd_lc_list" model="ir.ui.view">
        <field name="name">dsd.loading.confirmation.list</field>
        <field name="model">dsd.loading.confirmation</field>
        <field name="arch" type="xml">
            <list string="Loading Confirmations">
                <field name="name"/>
                <field name="tour_id"/>
                <field name="counting_scope" optional="hide"/>
                <field name="difference_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>
    <record id="action_dsd_lc" model="ir.actions.act_window">
        <field name="name">Loading Confirmations</field>
        <field name="res_model">dsd.loading.confirmation</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== Check-Out / Check-In ===================== -->
    <record id="view_dsd_check_form" model="ir.ui.view">
        <field name="name">dsd.check.record.form</field>
        <field name="model">dsd.check.record</field>
        <field name="arch" type="xml">
            <form string="Check-Out / Check-In">
                <header>
                    <button name="action_confirm" type="object" string="Confirm Check"
                            class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_reprepare" type="object" string="Re-Prepare Van Stock"
                            invisible="state != 'open'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,confirmed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tour_id" readonly="state == 'confirmed'"/>
                            <field name="check_type" widget="radio" readonly="state == 'confirmed'"/>
                            <field name="is_reload_check" readonly="state == 'confirmed'"/>
                        </group>
                        <group>
                            <field name="checked_by_id" readonly="state == 'confirmed'"/>
                            <field name="countersigned_by_id"/>
                            <field name="has_difference" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Material Count" name="material">
                            <field name="material_line_ids" readonly="state == 'confirmed'">
                                <list editable="bottom" decoration-danger="counted_qty != planned_qty">
                                    <field name="product_id" readonly="1"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="planned_qty"/>
                                    <field name="counted_qty"/>
                                    <field name="reason_id" invisible="counted_qty == planned_qty"
                                           required="counted_qty != planned_qty"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cash &amp; Payments" name="payments">
                            <field name="payment_line_ids" readonly="state == 'confirmed'">
                                <list editable="bottom" decoration-danger="counted_amount != expected_amount">
                                    <field name="journal_id"/>
                                    <field name="expected_amount"/>
                                    <field name="counted_amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="reason_id" invisible="counted_amount == expected_amount"
                                           required="counted_amount != expected_amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_dsd_check_list" model="ir.ui.view">
        <field name="name">dsd.check.record.list</field>
        <field name="model">dsd.check.record</field>
        <field name="arch" type="xml">
            <list string="Check-Out / Check-In">
                <field name="name"/>
                <field name="tour_id"/>
                <field name="check_type"/>
                <field name="is_reload_check" optional="hide"/>
                <field name="has_difference"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'"/>
            </list>
        </field>
    </record>
    <record id="action_dsd_check" model="ir.actions.act_window">
        <field name="name">Check-Out / Check-In</field>
        <field name="res_model">dsd.check.record</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_check_type': 'out'}</field>
    </record>

    <!-- ===================== Reload wizard ===================== -->
    <record id="view_dsd_reload_form" model="ir.ui.view">
        <field name="name">dsd.reload.form</field>
        <field name="model">dsd.reload</field>
        <field name="arch" type="xml">
            <form string="Reload / Unload Van">
                <group>
                    <field name="tour_id"/>
                    <field name="warehouse_id"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity" string="Qty (+load / −unload)"/>
                        <field name="uom_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" type="object" string="Apply Reload"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_dsd_reload" model="ir.actions.act_window">
        <field name="name">Reload Van</field>
        <field name="res_model">dsd.reload</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ===================== Tour (batch) execution buttons ===================== -->
    <record id="view_dsd_tour_form_execution" model="ir.ui.view">
        <field name="name">stock.picking.batch.form.dsd.execution</field>
        <field name="model">stock.picking.batch</field>
        <field name="inherit_id" ref="stock.stock_picking_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_dsd_start" type="object" string="Depart"
                        class="btn-primary" invisible="dsd_state != 'checked_out'"
                        groups="dsd.group_dsd_dispatcher"/>
                <button name="action_dsd_open_reload" type="object" string="Reload"
                        invisible="dsd_state not in ('checked_out', 'in_progress')"
                        groups="dsd.group_dsd_dispatcher"/>
            </xpath>
            <xpath expr="//page[@name='dsd_tour']" position="inside">
                <group string="Execution">
                    <field name="dsd_check_ids" colspan="2" nolabel="1"
                           context="{'default_tour_id': id}"/>
                </group>
                <group string="Loading Confirmations">
                    <field name="dsd_loading_confirmation_ids" colspan="2" nolabel="1"
                           context="{'default_tour_id': id}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
