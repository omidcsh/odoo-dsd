<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Organization -->
    <record id="view_dsd_sales_org_list" model="ir.ui.view">
        <field name="name">dsd.sales.org.list</field>
        <field name="model">dsd.sales.org</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dsd_sales_org_form" model="ir.ui.view">
        <field name="name">dsd.sales.org.form</field>
        <field name="model">dsd.sales.org</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dsd_sales_org" model="ir.actions.act_window">
        <field name="name">Sales Organizations</field>
        <field name="res_model">dsd.sales.org</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Distribution Channel -->
    <record id="view_dsd_distribution_channel_list" model="ir.ui.view">
        <field name="name">dsd.distribution.channel.list</field>
        <field name="model">dsd.distribution.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dsd_distribution_channel_form" model="ir.ui.view">
        <field name="name">dsd.distribution.channel.form</field>
        <field name="model">dsd.distribution.channel</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dsd_distribution_channel" model="ir.actions.act_window">
        <field name="name">Distribution Channels</field>
        <field name="res_model">dsd.distribution.channel</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Division -->
    <record id="view_dsd_division_list" model="ir.ui.view">
        <field name="name">dsd.division.list</field>
        <field name="model">dsd.division</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dsd_division_form" model="ir.ui.view">
        <field name="name">dsd.division.form</field>
        <field name="model">dsd.division</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dsd_division" model="ir.actions.act_window">
        <field name="name">Divisions</field>
        <field name="res_model">dsd.division</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Sales Area (valid combination) -->
    <record id="view_dsd_sales_area_list" model="ir.ui.view">
        <field name="name">dsd.sales.area.list</field>
        <field name="model">dsd.sales.area</field>
        <field name="arch" type="xml">
            <list>
                <field name="display_name" string="Sales Area"/>
                <field name="sales_org_id"/>
                <field name="dist_channel_id"/>
                <field name="division_id"/>
            </list>
        </field>
    </record>

    <record id="view_dsd_sales_area_form" model="ir.ui.view">
        <field name="name">dsd.sales.area.form</field>
        <field name="model">dsd.sales.area</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="sales_org_id"/>
                            <field name="dist_channel_id"/>
                            <field name="division_id"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dsd_sales_area_search" model="ir.ui.view">
        <field name="name">dsd.sales.area.search</field>
        <field name="model">dsd.sales.area</field>
        <field name="arch" type="xml">
            <search>
                <field name="sales_org_id"/>
                <field name="dist_channel_id"/>
                <field name="division_id"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_dsd_sales_area" model="ir.actions.act_window">
        <field name="name">Sales Areas</field>
        <field name="res_model">dsd.sales.area</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
