<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsd_route_list" model="ir.ui.view">
        <field name="name">dsd.route.list</field>
        <field name="model">dsd.route</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="sales_area_id" optional="show"/>
                <field name="warehouse_id" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dsd_route_form" model="ir.ui.view">
        <field name="name">dsd.route.form</field>
        <field name="model">dsd.route</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="sales_area_id"/>
                            <field name="warehouse_id"/>
                        </group>
                        <group>
                            <field name="driver_ids" widget="many2many_tags"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Customers" name="customers">
                            <field name="customer_sequence_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="sales_area_id"/>
                                    <field name="valid_from" optional="show"/>
                                    <field name="valid_to" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dsd_route_search" model="ir.ui.view">
        <field name="name">dsd.route.search</field>
        <field name="model">dsd.route</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <field name="sales_area_id"/>
                <field name="warehouse_id"/>
                <field name="driver_ids"/>
                <filter name="archived" string="Archived"
                        domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_by_sales_area" string="Sales Area"
                            context="{'group_by': 'sales_area_id'}"/>
                    <filter name="group_by_warehouse" string="Warehouse"
                            context="{'group_by': 'warehouse_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dsd_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">dsd.route</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
