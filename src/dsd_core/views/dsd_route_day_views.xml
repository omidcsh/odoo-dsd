<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsd_route_day_list" model="ir.ui.view">
        <field name="name">dsd.route.day.list</field>
        <field name="model">dsd.route.day</field>
        <field name="arch" type="xml">
            <list decoration-info="state in ('draft', 'loaded')"
                  decoration-success="state == 'settled'">
                <field name="name"/>
                <field name="date"/>
                <field name="route_id"/>
                <field name="driver_id" widget="many2one_avatar_user"/>
                <field name="vehicle_id"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'loaded')"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state in ('done', 'settled')"/>
                <field name="visit_count" string="Visits"/>
                <field name="pending_visit_count" string="Pending"/>
            </list>
        </field>
    </record>

    <record id="view_dsd_route_day_form" model="ir.ui.view">
        <field name="name">dsd.route.day.form</field>
        <field name="model">dsd.route.day</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,loaded,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_visits" type="object"
                                class="oe_stat_button" icon="fa-map-signs">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Run">
                            <field name="route_id"/>
                            <field name="date"/>
                            <field name="mode"/>
                        </group>
                        <group string="Resources">
                            <field name="driver_id" widget="many2one_avatar_user"/>
                            <field name="vehicle_id"/>
                            <field name="van_location_id"/>
                            <field name="warehouse_id" groups="stock.group_stock_multi_warehouses"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="visits" string="Visits">
                            <field name="visit_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'skipped'"
                                           decoration-success="state == 'done'"/>
                                    <field name="skip_reason"
                                           invisible="state != 'skipped'"/>
                                    <field name="sale_order_id" optional="show"/>
                                    <field name="delivery_id" optional="show"/>
                                    <field name="return_id" optional="hide"/>
                                    <field name="invoice_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dsd_route_day_search" model="ir.ui.view">
        <field name="name">dsd.route.day.search</field>
        <field name="model">dsd.route.day</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="route_id"/>
                <field name="driver_id"/>
                <filter name="today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="open" string="Open"
                        domain="[('state', 'not in', ('done', 'settled'))]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_route" string="Route" context="{'group_by': 'route_id'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dsd_route_day" model="ir.actions.act_window">
        <field name="name">Route Days</field>
        <field name="res_model">dsd.route.day</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dsd_route_days"
              name="Route Days"
              parent="menu_dsd_root"
              action="action_dsd_route_day"
              sequence="5"/>

    <menuitem id="menu_dsd_routes_conf"
              name="Routes"
              parent="menu_dsd_root"
              action="action_dsd_route"
              sequence="20"/>
</odoo>
