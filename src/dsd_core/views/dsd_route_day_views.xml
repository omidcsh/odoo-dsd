<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsd_route_day_list" model="ir.ui.view">
        <field name="name">dsd.route.day.list</field>
        <field name="model">dsd.route.day</field>
        <field name="arch" type="xml">
            <list decoration-info="state in ('draft', 'loaded')"
                  decoration-success="state == 'settled'">
                <field name="name"/>
                <field name="date"/>
                <field name="route_id"/>
                <field name="driver_id" widget="many2one_avatar_user"/>
                <field name="vehicle_id"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('draft', 'loaded')"
                       decoration-warning="state == 'in_progress'"
                       decoration-success="state in ('done', 'settled')"/>
                <field name="visit_count" string="Visits"/>
                <field name="pending_visit_count" string="Pending"/>
            </list>
        </field>
    </record>

    <record id="view_dsd_route_day_form" model="ir.ui.view">
        <field name="name">dsd.route.day.form</field>
        <field name="model">dsd.route.day</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,loaded,in_progress,done"/>
                    <button name="action_load_van" type="object"
                            string="Load Van" class="btn-primary"
                            icon="fa-truck"
                            invisible="state != 'draft'"/>
                    <button name="action_start_route" type="object"
                            string="Start Route" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_end_route" type="object"
                            string="End Route" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_create_stock_return" type="object"
                            string="Return Stock"
                            invisible="state not in ('in_progress', 'done')"/>
                    <button name="action_settle" type="object"
                            string="Settle Route Day" class="btn-primary"
                            invisible="state != 'done' or settlement_ids"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_visits" type="object"
                                class="oe_stat_button" icon="fa-map-signs">
                            <field name="visit_count" widget="statinfo" string="Visits"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Run">
                            <field name="route_id"/>
                            <field name="date"/>
                            <field name="mode"/>
                            <field name="load_picking_id"
                                   invisible="not load_picking_id"/>
                        </group>
                        <group string="Resources">
                            <field name="driver_id" widget="many2one_avatar_user"/>
                            <field name="vehicle_id"/>
                            <field name="van_location_id"/>
                            <field name="warehouse_id" groups="stock.group_stock_multi_warehouses"/>
                            <field name="return_picking_id"
                                   invisible="not return_picking_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="visits" string="Visits">
                            <field name="visit_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="partner_id"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'skipped'"
                                           decoration-success="state == 'done'"/>
                                    <field name="skip_reason"
                                           invisible="state != 'skipped'"/>
                                    <field name="sale_order_id" optional="show"/>
                                    <field name="delivery_id" optional="show"/>
                                    <field name="return_id" optional="hide"/>
                                    <field name="invoice_id" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dsd_route_day_search" model="ir.ui.view">
        <field name="name">dsd.route.day.search</field>
        <field name="model">dsd.route.day</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="route_id"/>
                <field name="driver_id"/>
                <filter name="today" string="Today"
                        domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="open" string="Open"
                        domain="[('state', 'not in', ('done', 'settled'))]"/>
                <group>
                    <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                    <filter name="group_route" string="Route" context="{'group_by': 'route_id'}"/>
                    <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_dsd_visit_form" model="ir.ui.view">
        <field name="name">dsd.visit.form</field>
        <field name="model">dsd.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,done"/>
                    <field name="route_mode" invisible="1"/>
                    <field name="sale_state" invisible="1"/>
                    <button name="action_start_van_sale" type="object"
                            string="Van Sale" class="btn-primary"
                            invisible="state != 'pending' or sale_order_id or delivery_id or route_mode == 'presale'"/>
                    <button name="action_create_presale" type="object"
                            string="Presale Order"
                            invisible="state != 'pending' or sale_order_id or delivery_id or route_mode == 'van_sales'"/>
                    <button name="action_complete_van_sale" type="object"
                            string="Complete Van Sale" class="btn-primary"
                            invisible="sale_kind != 'van_sale' or not sale_order_id or sale_state != 'sale' or state != 'pending'"
                            help="Ship from the van, invoice and register the cash"/>
                    <button name="action_deliver" type="object"
                            string="Deliver from Van"
                            invisible="state != 'pending' or delivery_id or sale_order_id"/>
                    <button name="action_take_return" type="object"
                            string="Take Return"
                            invisible="state != 'pending' or return_id"/>
                </header>
                <sheet>
                    <group>
                        <group string="Visit">
                            <field name="route_day_id"/>
                            <field name="sequence"/>
                            <field name="partner_id"/>
                            <field name="sale_kind" invisible="not sale_kind"/>
                            <field name="skip_reason"
                                   invisible="state != 'skipped'"/>
                        </group>
                        <group string="Documents">
                            <field name="sale_order_id"/>
                            <field name="delivery_id"/>
                            <field name="return_id"/>
                            <field name="invoice_id"/>
                            <field name="payment_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Proof of Delivery">
                        <field name="signature" widget="image"
                               options='{"size": [300, 150]}'
                               readonly="state == 'done' and signature"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dsd_visit_list" model="ir.ui.view">
        <field name="name">dsd.visit.list</field>
        <field name="model">dsd.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="route_day_id"/>
                <field name="partner_id"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'skipped'"
                       decoration-success="state == 'done'"/>
                <field name="delivery_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_dsd_route_day_kanban" model="ir.ui.view">
        <field name="name">dsd.route.day.kanban</field>
        <field name="model">dsd.route.day</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="date"/>
                <field name="route_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="state"/>
                <field name="visit_count"/>
                <field name="pending_visit_count"/>
                <field name="total_sales"/>
                <field name="cash_collected"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <t t-out="record.name.value"/>
                                    </strong>
                                    <small class="o_kanban_record_subtitle">
                                        <t t-out="record.route_id.value"/>
                                        · <t t-out="record.date.value"/>
                                    </small>
                                </div>
                                <field name="state" widget="badge"
                                       decoration-info="state in ('draft', 'loaded')"
                                       decoration-warning="state == 'in_progress'"
                                       decoration-success="state in ('done', 'settled')"/>
                            </div>
                            <div class="o_kanban_record_body">
                                <div>
                                    <span class="me-2">
                                        <t t-out="record.visit_count.value"/> visits
                                    </span>
                                    <span t-if="record.pending_visit_count.raw_value">
                                        <t t-out="record.pending_visit_count.value"/> pending
                                    </span>
                                </div>
                                <div t-if="record.driver_id.value" class="text-muted">
                                    <t t-out="record.driver_id.value"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="d-flex justify-content-between">
                                    <span>
                                        <i class="fa fa-money me-1"/>
                                        <t t-out="record.cash_collected.value"/>
                                        <t t-out="record.currency_id.symbol"/>
                                    </span>
                                    <span>
                                        <i class="fa fa-shopping-cart me-1"/>
                                        <t t-out="record.total_sales.value"/>
                                        <t t-out="record.currency_id.symbol"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_dsd_route_day_graph" model="ir.ui.view">
        <field name="name">dsd.route.day.graph</field>
        <field name="model">dsd.route.day</field>
        <field name="arch" type="xml">
            <graph>
                <field name="route_id"/>
                <field name="total_sales" type="measure"/>
                <field name="cash_collected" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_dsd_route_day_pivot" model="ir.ui.view">
        <field name="name">dsd.route.day.pivot</field>
        <field name="model">dsd.route.day</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="route_id"/>
                <field name="date" interval="day"/>
                <field name="total_sales" type="measure"/>
                <field name="cash_collected" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_dsd_reporting" model="ir.actions.act_window">
        <field name="name">DSD Reporting</field>
        <field name="res_model">dsd.route.day</field>
        <field name="view_mode">pivot,graph</field>
        <field name="context">{'search_default_group_route': 1}</field>
    </record>

    <menuitem id="menu_dsd_reporting"
              name="Reporting"
              parent="menu_dsd_root"
              action="action_dsd_reporting"
              sequence="15"/>

    <record id="action_dsd_route_day" model="ir.actions.act_window">
        <field name="name">Route Days</field>
        <field name="res_model">dsd.route.day</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <menuitem id="menu_dsd_route_days"
              name="Route Days"
              parent="menu_dsd_root"
              action="action_dsd_route_day"
              sequence="5"/>

    <menuitem id="menu_dsd_routes_conf"
              name="Routes"
              parent="menu_dsd_root"
              action="action_dsd_route"
              sequence="20"/>
</odoo>
