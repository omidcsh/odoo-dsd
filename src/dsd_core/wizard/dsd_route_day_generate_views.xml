<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_dsd_route_day_generate_form" model="ir.ui.view">
        <field name="name">dsd.route.day.generate.wizard.form</field>
        <field name="model">dsd.route.day.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Route Day">
                <group>
                    <group>
                        <field name="route_id" placeholder="Pick a route"/>
                        <field name="date"/>
                        <field name="weekday"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_dsd_route_day_generate" model="ir.actions.act_window">
        <field name="name">Generate Route Day</field>
        <field name="res_model">dsd.route.day.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
